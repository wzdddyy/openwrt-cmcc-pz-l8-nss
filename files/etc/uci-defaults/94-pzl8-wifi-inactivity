#!/bin/sh
# hostapd's inactivity check reads mac80211's per-station last_rx, and NSS
# offload never updates it: the clients' frames go through NSS and never reach
# the host.  Left at hostapd's 300 s default, every station is deauthenticated
# five minutes after joining and reconnects immediately.
#
# The shipped wireless config already carries the option; this handles a
# configuration kept across sysupgrade.  A value the user set is left alone.

changed=0
for section in $(uci -q show wireless | sed -n 's/^\(wireless\.[^=]*\)=wifi-iface$/\1/p'); do
	[ "$(uci -q get "$section.mode")" = "ap" ] || continue
	[ -n "$(uci -q get "$section.max_inactivity")" ] && continue
	uci -q set "$section.max_inactivity=86400"
	changed=1
done

[ "$changed" = 1 ] && uci -q commit wireless

exit 0
